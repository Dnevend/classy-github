---
import { siteOrigin } from "../lib/site";
import { DEFAULT_CONFIG } from '../lib/config';
import type { SeoMeta } from '../lib/seo';
import { resolveTheme } from '../themes';
import { createTranslator, localeFromAcceptLanguage } from '../lib/i18n';
import RecentVisits from '../themes/_shared/RecentVisits.astro';
import LandingScene from '../components/LandingScene.astro';

// 首页要跟随用户选择的主题，因此从静态资源改为按需渲染
export const prerender = false;

// 语言优先由 middleware 按 ?lang= > cookie > Accept-Language 解析；
// 这里只处理完全没有语言信号、需要回退默认值的情况。
if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromAcceptLanguage(
    Astro.request.headers.get('accept-language')
  );
}

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const t = createTranslator(Astro.locals.locale);
const { Layout } = components;

const origin = siteOrigin(Astro.url);

const seo: SeoMeta = {
  title: `ClassyGit · ${t('landing.title')}`,
  description: t('landing.seoDescription'),
  canonical: `${origin}/`,
  image: `${origin}/images/social-preview.png`,
  imageWidth: 1280,
  imageHeight: 640,
  imageAlt: t('landing.ogAlt'),
  robots: 'index, follow',
};
---

<Layout user="" userinfo={null} config={DEFAULT_CONFIG} theme={themeName} {seo}>
  <section class="hero">
    <h1>{t('landing.title')}</h1>
    <p>{t('landing.subtitle')}</p>

    <form id="lookup" method="get" action="/" data-nosnippet>
      <label class="sr-only" for="username">
        <span data-nosnippet>{t('landing.label')}</span>
      </label>
      <input
        id="username"
        name="u"
        placeholder={t('landing.placeholder')}
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        required
      />
      <button type="submit">
        <span data-nosnippet>{t('landing.submit')}</span>
      </button>
    </form>

    <p class="hero-links">
      <a href="/setup">{t('setup.title')}</a>
      <span aria-hidden="true">·</span>
      <a href="/webring">{t('webring.title')}</a>
      <span aria-hidden="true">·</span>
      <a href="/random">{t('webring.random')}</a>
      <span aria-hidden="true">·</span>
      <a href="/nft">{t('landing.nft')}</a>
    </p>

    <RecentVisits />
  </section>

  <LandingScene theme={themeName} />

  <script is:inline>
    const form = document.getElementById('lookup');
    const input = document.getElementById('username');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = input?.value.trim().replace(/^@/, '');

      if (name) window.location.href = `/${encodeURIComponent(name)}`;
    });
  </script>
</Layout>
