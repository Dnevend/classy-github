---
import { siteOrigin } from "../lib/site";
import NotFound from '../components/NotFound.astro';
import ServiceError from '../components/ServiceError.astro';
import { DEFAULT_CONFIG } from '../lib/config';
import { loadConfigState } from '../lib/config-loader';
import { safeLoad } from '../lib/errors';
import { getDefaultBranch } from '../lib/github';
import { createTranslator, localeFromAcceptLanguage } from '../lib/i18n';
import { loadUser } from '../lib/page';
import { resolveTheme } from '../themes';

export const prerender = false;

const t = createTranslator(Astro.locals.locale);
const origin = siteOrigin(Astro.url);
const user = (Astro.url.searchParams.get('u') ?? '').trim();

// 配置生成器没有站主配置可参考，语言按浏览器决定。
if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromAcceptLanguage(
    Astro.request.headers.get('accept-language')
  );
}

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout } = components;

const seo = {
  title: `${t('setup.title')} · ClassyGit`,
  description: t('setup.desc'),
  canonical: user ? `${origin}/setup?u=${encodeURIComponent(user)}` : `${origin}/setup`,
  robots: 'noindex, follow',
};

if (!user) {
  // 没有用户名时只渲染一个入口；不请求 GitHub。
  // 这个分支在模板里单独处理。
}

const { data: userinfo, error } = user
  ? await safeLoad(() => loadUser(user))
  : { data: null, error: null };

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (user && !userinfo) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

const configState = userinfo
  ? await loadConfigState(user)
  : {
      config: DEFAULT_CONFIG,
      configured: false,
      reliable: false,
      source: 'default' as const,
    };
const { config, configured, reliable } = configState;

if (userinfo && !configured && !reliable) {
  Astro.response.status = 503;
  Astro.response.headers.set('cache-control', 'no-store');
}

const branch = userinfo
  ? await getDefaultBranch(userinfo.login).catch(() => null)
  : null;

const themeOptions = ['mac', 'nes', 'win98', 'tui'] as const;
const languageOptions = ['en', 'zh'] as const;

const initialConfig = {
  owner: userinfo?.login ?? user,
  theme: config.theme === 'default' ? 'mac' : config.theme,
  language: config.language,
  profile: { ...config.profile },
  gists: config.gists,
  links:
    config.links.length > 0
      ? config.links
      : [{ title: 'GitHub', href: `https://github.com/${userinfo?.login ?? user}` }],
  nav: config.nav,
  now: config.now,
  guestbook: config.guestbook,
  webring: config.webring,
  discover: config.discover,
  seo: config.seo,
};

const initialJson = JSON.stringify(initialConfig, null, 2);
const forkUrl = 'https://github.com/Dnevend/classy-github/fork';
const editUrl = branch
  ? `https://github.com/${encodeURIComponent(userinfo?.login ?? user)}/classy-github/edit/${encodeURIComponent(branch)}/classy.config.json`
  : null;
const previewUrl = user
  ? `/${encodeURIComponent(user)}?theme=${initialConfig.theme}&lang=${initialConfig.language}&preview=1`
  : '';

const display = userinfo?.name || userinfo?.login || user;
---

<Layout
  user={user}
  userinfo={userinfo}
  config={DEFAULT_CONFIG}
  theme={themeName}
  brand={user ? display : undefined}
  seo={seo}
>
  {
    !user ? (
      <section class="setup-page setup-page--start">
        <h1 class="page-title">{t('setup.title')}</h1>
        <p class="bio">{t('setup.noUser')}</p>
        <form class="setup-start" method="get" action="/setup">
          <label class="sr-only" for="setup-user">{t('setup.username')}</label>
          <input
            id="setup-user"
            name="u"
            placeholder={t('setup.username')}
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            required
          />
          <button type="submit">{t('setup.start')} →</button>
        </form>
      </section>
    ) : error ? (
      <ServiceError kind={error} />
    ) : !userinfo ? (
      <NotFound user={user} />
    ) : !configured && !reliable ? (
      <ServiceError kind="unknown" />
    ) : (
      <section class="setup-page">
        <header class="setup-page__head">
          <h1 class="page-title">{t('setup.title')}</h1>
          <p class="bio">{t('setup.desc')}</p>
        </header>

        <div class="setup-grid">
          <form
            id="setup-form"
            class="setup-form"
            data-user={user}
            data-link-title={t('setup.linkTitle')}
            data-link-href={t('setup.linkHref')}
          >
            <section class="setup-section">
              <div class="setup-row">
                <label for="setup-theme">{t('setup.theme')}</label>
                <select id="setup-theme" name="theme">
                  {themeOptions.map((option) => (
                    <option value={option} selected={initialConfig.theme === option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
              <div class="setup-row">
                <label for="setup-language">{t('setup.language')}</label>
                <select id="setup-language" name="language">
                  {languageOptions.map((option) => (
                    <option value={option} selected={initialConfig.language === option}>
                      {option}
                    </option>
                  ))}
                </select>
              </div>
            </section>

            <section class="setup-section">
              <h2>{t('setup.profile')}</h2>
              <div class="setup-row">
                <label for="setup-show-count">{t('setup.showCount')}</label>
                <input
                  id="setup-show-count"
                  name="showCount"
                  type="number"
                  min="0"
                  max="100"
                  value={initialConfig.profile.repos.showCount}
                />
              </div>
              <label class="setup-check">
                <input
                  type="checkbox"
                  name="showFollowers"
                  checked={initialConfig.profile.showFollowers}
                />
                {t('setup.showFollowers')}
              </label>
              <label class="setup-check">
                <input
                  type="checkbox"
                  name="showFollowing"
                  checked={initialConfig.profile.showFollowing}
                />
                {t('setup.showFollowing')}
              </label>
            </section>

            <section class="setup-section">
              <h2>{t('setup.links')}</h2>
              <div id="setup-links">
                {initialConfig.links.map((link) => (
                  <div class="setup-link-row">
                    <input
                      class="link-title"
                      placeholder={t('setup.linkTitle')}
                      value={link.title}
                    />
                    <input
                      class="link-href"
                      placeholder={t('setup.linkHref')}
                      value={link.href}
                    />
                    <button type="button" class="setup-remove" data-remove-link>
                      {t('setup.remove')}
                    </button>
                  </div>
                ))}
              </div>
              <button type="button" class="setup-add" id="setup-add-link">
                + {t('setup.addLink')}
              </button>
            </section>

            <section class="setup-section">
              <h2>{t('setup.now')}</h2>
              <div class="setup-row">
                <label for="setup-books">{t('setup.books')}</label>
                <input id="setup-books" name="books" value={initialConfig.now.books.join(', ')} />
              </div>
              <div class="setup-row">
                <label for="setup-music">{t('setup.music')}</label>
                <input id="setup-music" name="music" value={initialConfig.now.music.join(', ')} />
              </div>
              <div class="setup-row">
                <label for="setup-watching">{t('setup.watching')}</label>
                <input
                  id="setup-watching"
                  name="watching"
                  value={initialConfig.now.watching.join(', ')}
                />
              </div>
            </section>

            <section class="setup-section">
              <h2>{t('setup.community')}</h2>
              <label class="setup-row">
                <span>{t('setup.guestbook')}</span>
                <input
                  name="guestbook"
                  value={initialConfig.guestbook.gistId ?? ''}
                  placeholder="9ec0af…"
                />
              </label>
              <p class="setup-hint">
                {t('setup.guestbookHint')}{' '}
                <a
                  href="https://gist.github.com/?filename=guestbook.md"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t('setup.createGist')} ↗
                </a>
              </p>
              <label class="setup-check">
                <input type="checkbox" name="webring" checked={initialConfig.webring.enabled} />
                {t('setup.webring')}
              </label>
              <label class="setup-check">
                <input type="checkbox" name="discover" checked={initialConfig.discover.enabled} />
                {t('setup.discover')}
              </label>
            </section>

            <section class="setup-section">
              <h2>{t('setup.seoTitle')}</h2>
              <label class="setup-check">
                <input type="checkbox" name="seoIndex" checked={initialConfig.seo.index} />
                {t('setup.seo')}
              </label>
              <p class="setup-hint">{t('setup.seoHint')}</p>
            </section>
          </form>

          <aside class="setup-output">
            <div class="setup-output__head">
              <h2>{t('setup.output')}</h2>
              <button type="button" class="setup-copy" id="setup-copy" data-copied={t('setup.copied')}>
                {t('setup.copy')}
              </button>
            </div>
            <pre><code id="setup-json">{initialJson}</code></pre>

            <div class="setup-actions">
              <a class="setup-action" href={forkUrl} target="_blank" rel="noopener noreferrer">
                {t('setup.fork')} ↗
              </a>
              {editUrl && (
                <a class="setup-action" href={editUrl} target="_blank" rel="noopener noreferrer">
                  {t('setup.edit')} ↗
                </a>
              )}
              <a class="setup-action" href={previewUrl} target="_blank" rel="noopener noreferrer">
                {t('setup.preview')} ↗
              </a>
            </div>

            <p class="setup-hint">{t('setup.previewHint')}</p>
            <iframe
              id="setup-preview"
              class="setup-preview"
              src={previewUrl}
              title={t('setup.preview')}
              loading="lazy"
            ></iframe>
            <p class="setup-hint">{t('setup.note')}</p>
            <p class="setup-hint">{t('setup.applied')}</p>
          </aside>
        </div>
      </section>
    )
  }
</Layout>

{
  user && userinfo && (
    <>
      <script
        type="application/json"
        id="setup-initial"
        set:html={JSON.stringify(initialConfig).replace(/</g, '\\u003c')}
      />
      <script is:inline>
        (() => {
          const form = document.getElementById('setup-form');
          const output = document.getElementById('setup-json');
          const preview = document.getElementById('setup-preview');
          const initialEl = document.getElementById('setup-initial');
          const links = document.getElementById('setup-links');
          const addLink = document.getElementById('setup-add-link');
          const copy = document.getElementById('setup-copy');
          if (!form || !output || !initialEl || !links || !addLink || !copy) return;

          const initial = JSON.parse(initialEl.textContent || '{}');
          const user = form.dataset.user ?? '';

          const splitList = (value) =>
            value
              .split(',')
              .map((item) => item.trim())
              .filter(Boolean)
              .slice(0, 8);

          const readLinks = () =>
            [...links.querySelectorAll('.setup-link-row')]
              .map((row) => ({
                title: row.querySelector('.link-title')?.value.trim() ?? '',
                href: row.querySelector('.link-href')?.value.trim() ?? '',
              }))
              .filter((link) => link.title && link.href)
              .slice(0, 20);

          const build = () => {
            const config = {
              theme: form.theme.value,
              language: form.language.value,
              profile: {
                ...initial.profile,
                showFollowers: form.showFollowers.checked,
                showFollowing: form.showFollowing.checked,
                repos: {
                  ...initial.profile.repos,
                  showCount: Math.max(
                    0,
                    Math.min(100, Number(form.showCount.value) || 0)
                  ),
                },
              },
              gists: initial.gists,
              links: readLinks(),
              nav: initial.nav,
              now: {
                books: splitList(form.books.value),
                music: splitList(form.music.value),
                watching: splitList(form.watching.value),
              },
              guestbook: { gistId: form.guestbook.value.trim() || null },
              webring: { enabled: form.webring.checked },
              discover: { enabled: form.discover.checked },
              seo: { index: form.seoIndex.checked },
            };

            const json = JSON.stringify(config, null, 2);
            output.textContent = json;
            if (preview) {
              const nextPreview = `/${encodeURIComponent(user)}?theme=${config.theme}&lang=${config.language}&preview=1`;
              if (preview.getAttribute('src') !== nextPreview) {
                preview.src = nextPreview;
              }
            }
            return json;
          };

          const addRow = (link = { title: '', href: '' }) => {
            const row = document.createElement('div');
            row.className = 'setup-link-row';
            row.innerHTML = `
              <input class="link-title" value="">
              <input class="link-href" value="">
              <button type="button" class="setup-remove" data-remove-link>×</button>
            `;
            const title = row.querySelector('.link-title');
            const href = row.querySelector('.link-href');
            if (title) {
              title.placeholder = form.dataset.linkTitle ?? '';
              title.value = link.title;
            }
            if (href) {
              href.placeholder = form.dataset.linkHref ?? '';
              href.value = link.href;
            }
            links.append(row);
            title?.focus();
          };

          links.addEventListener('click', (event) => {
            const target = event.target;
            if (target instanceof HTMLElement && target.matches('[data-remove-link]')) {
              target.closest('.setup-link-row')?.remove();
              build();
            }
          });

          addLink.addEventListener('click', () => {
            addRow();
            build();
          });

          form.addEventListener('input', build);
          form.addEventListener('change', build);
          form.addEventListener('submit', (event) => event.preventDefault());

          copy.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(build());
              const original = copy.textContent;
              copy.textContent = copy.dataset.copied ?? '✓';
              window.setTimeout(() => {
                copy.textContent = original;
              }, 1200);
            } catch {
              const range = document.createRange();
              range.selectNodeContents(output);
              const selection = window.getSelection();
              selection?.removeAllRanges();
              selection?.addRange(range);
            }
          });

          build();
        })();
      </script>
    </>
  )
}
