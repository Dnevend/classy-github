---
import { siteOrigin } from "../../../lib/site";
import NotFound from '../../../components/NotFound.astro';
import ServiceError from '../../../components/ServiceError.astro';
import { loadGistDetail } from '../../../lib/gist-detail';
import { renderMarkdown } from '../../../lib/markdown';
import { safeLoad } from '../../../lib/errors';
import { DEFAULT_CONFIG } from '../../../lib/config';
import { loadConfig } from '../../../lib/config-loader';
import { createTranslator, localeFromConfig } from '../../../lib/i18n';
import { createGistDescriptionParser } from '../../../lib/gist-rule';
import { estimateReadingMinutes } from '../../../lib/reading';
import { resolveTheme } from '../../../themes';

export const prerender = false;

const user = Astro.params.user as string;
const gistId = Astro.params.id as string;
const origin = siteOrigin(Astro.url);

const { data, error, retryAt } = await safeLoad(async () => {
  const gist = await loadGistDetail(user, gistId);
  const files = Object.values(gist.files);

  const rendered = await Promise.all(
    files.map(async (file) => {
      const isMarkdown = /\.(md|markdown|mdx)$/i.test(file.filename);

      // 非 markdown 文件包成代码块，交给同一条管线高亮
      const source = isMarkdown
        ? file.content
        : ['```' + (file.language || 'text'), file.content, '```'].join('\n');

      return { filename: file.filename, html: await renderMarkdown(source) };
    })
  );

  return { gist, files, rendered };
});

const config = data ? await loadConfig(user, { memo: Astro.locals.configMemo }) : DEFAULT_CONFIG;

if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout, Markdown } = components;

if (error === 'not-found') {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
}

const parsed = createGistDescriptionParser({
  prefix: config.gists.prefix,
  split: config.gists.split,
})(data?.gist.description);

const title = parsed.title || data?.files[0]?.filename || t('gist.untitled');
const readingMinutes = data
  ? estimateReadingMinutes(data.files.map((file) => file.content).join('\n'))
  : 0;
---

<Layout
  {user}
  userinfo={null}
  {config}
  theme={themeName}
  brand={user}
  share={data ? {
    title,
    description: (data.rendered[0] ? data.files[0].content.replace(/\s+/g, ' ').slice(0, 50) : undefined),
    handle: user,
    url: `${origin}/${user}/gist/${gistId}`,
  } : undefined}
  seo={{
    title: `${title} · ${user} · ClassyGit`,
    description: data?.gist.description ?? undefined,
    canonical: `${origin}/${user}/gist/${gistId}`,
    image: `${origin}/og/${encodeURIComponent(user)}.png?theme=${themeName}&v=3`,
    rss: `${origin}/${user}/rss.xml`,
    robots: 'noindex, follow',
  }}
>
  {
    error === 'not-found' ? (
      <NotFound user={`gist ${gistId}`} />
    ) : error ? (
      <ServiceError kind={error} retryAt={retryAt} />
    ) : data ? (
      <>
        <a class="back-link" href={`/${user}/gists`}>← {t('gists.title', { name: user })}</a>

        <header class="repo-detail">
          <h1 class="page-title">{title}</h1>
          <div class="repo-card__meta">
            {parsed.type && <span class="tag">{parsed.type}</span>}
            {parsed.tags.map((tag) => (
              <a class="tag" href={`/${user}/gists?tag=${encodeURIComponent(tag)}`}>
                #{tag}
              </a>
            ))}
            <span>{t('gist.files', { count: data.files.length })}</span>
            {readingMinutes > 0 && (
              <span>{t('gist.readingTime', { minutes: readingMinutes })}</span>
            )}
            <span>{t('gist.created', { date: data.gist.created_at.slice(0, 10) })}</span>
            <a href={data.gist.html_url} target="_blank" rel="noopener noreferrer">
              {t('repo.open')} ↗
            </a>
          </div>
        </header>

        {data.rendered.map((file) => (
          <>
            {data.rendered.length > 1 && <h2 class="section__title">{file.filename}</h2>}
            <Markdown html={file.html} title={file.filename} />
          </>
        ))}
      </>
    ) : null
  }
</Layout>
