---
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { getUserReadme, listRepos } from '../../lib/github';
import { renderMarkdown } from '../../lib/markdown';
import { safeLoad } from '../../lib/errors';
import { loadUser } from '../../lib/page';
import { langColor } from '../../lib/lang-color';
import { seoForProfile } from '../../lib/seo';
import { DEFAULT_CONFIG } from '../../lib/config';
import { loadConfig } from '../../lib/config-loader';
import { createTranslator, localeFromConfig } from '../../lib/i18n';
import { syncIndexableUser, usersKv } from '../../lib/users-kv';
import { resolveTheme } from '../../themes';

// 用户集合是无限的，这条路由只能按需渲染
export const prerender = false;

const user = Astro.params.user as string;
const origin = new URL(Astro.url).origin;

const { data, error } = await safeLoad(async () => {
  const userinfo = await loadUser(user);
  if (!userinfo) return null;

  const [repos, readme] = await Promise.all([listRepos(user), getUserReadme(user)]);

  return { userinfo, repos, readme };
});

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!data) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

// 配置读取失败不影响渲染：loadConfig 内部已降级为默认值
const config = data ? await loadConfig(user) : DEFAULT_CONFIG;

if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);


// 只有显式开启 seo.index 的用户才进 sitemap
if (data) {
  await syncIndexableUser(usersKv(), data.userinfo.login, config.seo.index);
}

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout, ProfileCard, RepoCard, Markdown } = components;

const readmeHtml =
  data?.readme
    ? await renderMarkdown(data.readme.source, { base: data.readme.base })
    : null;

// 展示多少个仓库由用户的 classy.config.json 决定
const topRepos = data ? data.repos.slice(0, config.profile.repos.showCount) : [];

// 语言分布（按仓库数）——填满右侧资料卡下方的空白
const languageCounts = new Map<string, number>();
for (const repo of data?.repos ?? []) {
  if (!repo.language) continue;
  languageCounts.set(repo.language, (languageCounts.get(repo.language) ?? 0) + 1);
}
const languages = [...languageCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([name, count]) => ({ name, count, color: langColor(name) }));
const display = data?.userinfo.name || data?.userinfo.login || user;

const seo = data
  ? seoForProfile({
      user,
      userinfo: data.userinfo,
      origin,
      indexable: config.seo.index,
      theme: themeName,
    })
  : {
      title: error ? '数据暂时取不到 · ClassyGit' : `找不到用户 ${user} · ClassyGit`,
      robots: 'noindex, follow',
      canonical: `${origin}/${user}`,
    };
---

<Layout
  {user}
  userinfo={data?.userinfo ?? null}
  {config}
  theme={themeName}
  brand={display}
  {seo}
>
  {
    error ? (
      <ServiceError kind={error} />
    ) : !data ? (
      <NotFound user={user} />
    ) : (
      <div class="profile">
        <div class="profile__main">
          {readmeHtml ? (
            <Markdown html={readmeHtml} />
          ) : (
            <div class="card">
              <p class="bio" style="margin:0">
                {t('profile.noReadme')}
              </p>
            </div>
          )}

          {config.profile.repos.visible && topRepos.length > 0 && (
            <section class="section">
              <h2 class="section__title">{t('section.recent')}</h2>
              <ul class="repo-grid">
                {topRepos.map((repo) => (
                  <RepoCard repo={repo} href={`/${user}/repo/${repo.name}`} />
                ))}
              </ul>
            </section>
          )}
        </div>

        <ProfileCard
          user={user}
          userinfo={data.userinfo}
          {config}
          links={{ repos: `/${user}/repos`, gists: `/${user}/gists` }}
          {languages}
        />
      </div>
    )
  }
</Layout>
