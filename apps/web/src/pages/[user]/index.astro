---
import { siteOrigin } from "../../lib/site";
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { renderMarkdown } from '../../lib/markdown';
import { safeLoad } from '../../lib/errors';
import { loadProfile } from '../../lib/profile';
import { seoForProfile } from '../../lib/seo';
import { loadConfigState } from '../../lib/config-loader';
import { buildDefaultReadme } from '../../lib/default-readme';
import { createTranslator, localeFromConfig } from '../../lib/i18n';
import { createGistDescriptionParser } from '../../lib/gist-rule';
import { syncIndexableUser, usersKv } from '../../lib/users-kv';
import { removeSite, syncSite } from '../../lib/site-registry';
import { resolveTheme } from '../../themes';
import ContribWall from '../../themes/_shared/ContribWall.astro';
import ClaimBanner from '../../themes/_shared/ClaimBanner.astro';
import NowCard from '../../themes/_shared/NowCard.astro';
import SideCard from '../../themes/_shared/SideCard.astro';

// 用户集合是无限的，这条路由只能按需渲染
export const prerender = false;

const user = Astro.params.user as string;
const origin = siteOrigin(Astro.url);

// 配置用来决定一次拉多少个仓库（showCount）；预览页不走缓存，
// 保证刚保存的 classy.config.json 立刻可见。
const isPreview = Astro.url.searchParams.get('preview') === '1';
const configState = await loadConfigState(user, { fresh: isPreview, memo: Astro.locals.configMemo });
const { config, configured, reliable } = configState;

const wantsRepos = config.profile.repos.visible;
const wantsGists =
  config.profile.gists.visible && config.profile.gists.showCount > 0;

const { data, error, retryAt } = await safeLoad(() =>
  loadProfile(user, {
    repoCount: wantsRepos ? config.profile.repos.showCount : 0,
    gistCount: wantsGists ? config.profile.gists.showCount : 0,
    fresh: isPreview,
  })
);

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!data) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);


// 只有显式开启 seo.index 的用户才进 sitemap。
// 配置读取失败时不要动注册表，否则 GitHub 抖动会把用户误删。
if (data && reliable) {
  await syncIndexableUser(usersKv(), data.userinfo.login, config.seo.index);
}

if (data) {
  // 站点注册表：webring / 随机推荐 / 徽章页都依赖它
  if (configured) {
    await syncSite(usersKv(), {
      login: data.userinfo.login,
      title: data.userinfo.name || data.userinfo.login,
      theme: config.theme,
      webring: config.webring.enabled,
      discover: config.discover.enabled,
    });
  } else if (reliable) {
    // 只有明确「没有配置」才清理；网络错误不能误删 webring 成员
    await removeSite(usersKv(), data.userinfo.login);
  }
}

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout, ProfileCard, RepoCard, GistCard, Markdown } = components;

const display = data?.userinfo.name || data?.userinfo.login || user;

const readmeHtml = data
  ? data.readme
    ? await renderMarkdown(data.readme.source, {
        base: data.readme.base,
        repo: { login: data.userinfo.login, repo: data.userinfo.login, path: data.readme.path },
      })
    : await renderMarkdown(
        buildDefaultReadme({
          user: data.userinfo.login,
          display,
          locale: Astro.locals.locale,
        })
      )
  : null;

// 展示多少个仓库由用户的 classy.config.json 决定
const topRepos = data ? data.repos.slice(0, config.profile.repos.showCount) : [];

const parseGistDescription = createGistDescriptionParser({
  prefix: config.gists.prefix,
  split: config.gists.split,
});
const recentGists = data
  ? data.gists
      .slice(0, config.profile.gists.showCount)
      .map((gist) => ({ gist, parsed: parseGistDescription(gist.description) }))
  : [];

const seo = data
  ? {
      ...seoForProfile({
        user,
        userinfo: data.userinfo,
        origin,
        indexable: config.seo.index,
        theme: themeName,
        defaultTheme: config.theme,
      }),
      rss: `${origin}/${user}/rss.xml`,
    }
  : {
      title: error ? t('meta.error') : t('meta.notFoundUser', { user }),
      robots: 'noindex, follow',
      canonical: `${origin}/${user}`,
    };
---

<Layout
  {user}
  userinfo={data?.userinfo ?? null}
  {config}
  theme={themeName}
  brand={display}
  {configured}
  {seo}
>
  {
    error ? (
      <ServiceError kind={error} retryAt={retryAt} />
    ) : !data ? (
      <NotFound user={user} />
    ) : (
      <>
        {!configured && reliable && <ClaimBanner user={user} />}
        <div class="profile">
        <div class="profile__main">
          {readmeHtml && <Markdown html={readmeHtml} />}



          {config.profile.repos.visible && topRepos.length > 0 && (
            <section class="section">
              <div class="section__head">
                <h2 class="section__title">{t('section.recent')}</h2>
                <a class="section__more" href={`/${user}/repos`}>{t('section.more')} →</a>
              </div>
              <ul class="repo-grid">
                {topRepos.map((repo) => (
                  <RepoCard repo={repo} href={`/${user}/repo/${repo.name}`} />
                ))}
              </ul>
            </section>
          )}
        </div>

        <div class="profile__aside-wrap">
          <ProfileCard
            user={user}
            userinfo={data.userinfo}
            {config}
          />

          {config.profile.contrib.visible && (
            <SideCard title={t('contrib.title')}>
              <ContribWall user={user} theme={themeName} />
            </SideCard>
          )}

          <NowCard now={config.now} cardUrl={config.profile.cardUrl} />

          {config.profile.gists.visible && recentGists.length > 0 && (
            <SideCard title={t('gists.recent')} variant="recent-gists">
              <ul class="gist-list side-card__gist-list">
                {recentGists.map(({ gist, parsed }) => (
                  <GistCard
                    gist={gist}
                    href={`/${user}/gist/${gist.id}`}
                    type={parsed.type}
                    compact
                    title={
                      parsed.title ||
                      Object.keys(gist.files)[0] ||
                      t('gist.untitled')
                    }
                  />
                ))}
              </ul>
            </SideCard>
          )}
        </div>
        </div>
      </>
    )
  }
</Layout>
