---
import { siteOrigin } from "../../lib/site";
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { DEFAULT_CONFIG } from '../../lib/config';
import { loadConfig } from '../../lib/config-loader';
import { safeLoad } from '../../lib/errors';
import { getGist, listGistComments } from '../../lib/github';
import { renderMarkdown } from '../../lib/markdown';
import { createTranslator, localeFromConfig } from '../../lib/i18n';
import { loadUser } from '../../lib/page';
import { resolveTheme } from '../../themes';

export const prerender = false;

const user = Astro.params.user as string;
const origin = siteOrigin(Astro.url);

const { data: userinfo, error } = await safeLoad(() => loadUser(user));

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!userinfo) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

const config = userinfo ? await loadConfig(user) : undefined;

if (config && Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);
const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout } = components;

const gistId = config?.guestbook.gistId ?? null;
let gist: Awaited<ReturnType<typeof getGist>> | null = null;
let comments: Awaited<ReturnType<typeof listGistComments>> = [];
let commentsUnavailable = false;

if (gistId) {
  gist = await getGist(gistId).catch(() => null);

  // 配置是公开的，必须确认这条 Gist 确实属于当前用户，
  // 否则任何人都能把别人的评论区嵌进自己的页面。
  // 同时只接受 public Gist：secret Gist 的评论不应该被公开渲染。
  if (
    gist &&
    (!gist.public ||
      gist.owner?.login?.toLowerCase() !== userinfo?.login.toLowerCase())
  ) {
    gist = null;
  }

  if (gist) {
    try {
      comments = await listGistComments(gistId);
    } catch {
      commentsUnavailable = true;
    }
  }
}

const rendered = await Promise.all(
  comments.map(async (comment) => {
    const truncated = comment.body.length > 5000;
    const source = truncated ? comment.body.slice(0, 5000) : comment.body;

    let html = '';
    let failed = false;

    try {
      html = await renderMarkdown(source, {
        allowImages: false,
        highlight: false,
      });
    } catch {
      // 单条外部评论不能把整页打挂；失败时只保留作者信息 + GitHub 链接
      failed = true;
    }

    let date = comment.created_at.slice(0, 10);
    try {
      date = new Intl.DateTimeFormat(
        Astro.locals.locale === 'zh' ? 'zh-CN' : 'en',
        { dateStyle: 'medium' }
      ).format(new Date(comment.created_at));
    } catch {
      // 保留 ISO 日期
    }

    return {
      comment,
      truncated: truncated || failed,
      html,
      date,
    };
  })
);

const display = userinfo?.name || userinfo?.login || user;
const gistUrl = gist ? `${gist.html_url}#comments` : null;
---

<Layout
  {user}
  userinfo={userinfo}
  config={config ?? DEFAULT_CONFIG}
  theme={themeName}
  brand={display}
  seo={{
    title: `${t('guestbook.title', { name: display })} · ClassyGit`,
    description: t('guestbook.desc'),
    canonical: `${origin}/${user}/guestbook`,
    robots: 'noindex, follow',
  }}
>
  {
    error ? (
      <ServiceError kind={error} />
    ) : !userinfo ? (
      <NotFound user={user} />
    ) : (
      <section class="guestbook">
        <a class="back-link" href={`/${user}`}>← {t('guestbook.back')}</a>

        <header class="guestbook__head">
          <h1 class="page-title">{t('guestbook.title', { name: display })}</h1>
          <p class="bio">{t('guestbook.desc')}</p>
          {gist && !commentsUnavailable && (
            <p class="guestbook__count">{t('guestbook.count', { count: comments.length })}</p>
          )}
        </header>

        {!gistId ? (
          <p class="bio">{t('guestbook.disabled')}</p>
        ) : !gist ? (
          <p class="bio">{t('guestbook.unavailable')}</p>
        ) : (
          <>
            {commentsUnavailable ? (
              <p class="bio">{t('guestbook.unavailable')}</p>
            ) : rendered.length === 0 ? (
              <p class="bio">{t('guestbook.empty')}</p>
            ) : (
              <ol class="guestbook-list">
                {rendered.map(({ comment, html, truncated, date }) => (
                  <li class="guestbook-entry">
                    <div class="guestbook-entry__head">
                      {comment.user?.avatar_url && (
                        <img
                          class="guestbook-entry__avatar"
                          src={comment.user.avatar_url}
                          alt=""
                          width="32"
                          height="32"
                          loading="lazy"
                        />
                      )}
                      <div>
                        <a
                          class="guestbook-entry__name"
                          href={comment.user?.html_url ?? 'https://github.com'}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          @{comment.user?.login ?? 'ghost'}
                        </a>
                        <time class="guestbook-entry__date" datetime={comment.created_at}>
                          {date}
                        </time>
                      </div>
                    </div>
                    <div class="prose" set:html={html} />
                    {truncated && (
                      <a
                        class="guestbook-entry__more"
                        href={comment.user?.html_url ?? gist.html_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {t('guestbook.view')} ↗
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            )}

            {gistUrl && (
              <div class="guestbook__actions">
                <a class="guestbook__cta" href={gistUrl} target="_blank" rel="noopener noreferrer">
                  {t('guestbook.leave')} ↗
                </a>
                <span class="guestbook__hosted">{t('guestbook.hosted')}</span>
              </div>
            )}
          </>
        )}
      </section>
    )
  }
</Layout>
