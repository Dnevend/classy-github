---
import { siteOrigin } from "../../lib/site";
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { listGists } from '../../lib/github';
import { safeLoad } from '../../lib/errors';
import { loadUser } from '../../lib/page';
import { DEFAULT_CONFIG } from '../../lib/config';
import { loadConfig } from '../../lib/config-loader';
import { createTranslator, localeFromConfig } from '../../lib/i18n';
import { createGistDescriptionParser } from '../../lib/gist-rule';
import { collectTagCounts, hasTag } from '../../lib/tags';
import { resolveTheme } from '../../themes';
import ListSearch from '../../themes/_shared/ListSearch.astro';

export const prerender = false;

const user = Astro.params.user as string;
const origin = siteOrigin(Astro.url);

const { data, error } = await safeLoad(async () => {
  const userinfo = await loadUser(user);
  if (!userinfo) return null;

  return { userinfo, gists: await listGists(user) };
});

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!data) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

const config = data ? await loadConfig(user) : DEFAULT_CONFIG;

if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);


const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout, GistCard } = components;

const display = data?.userinfo.name || data?.userinfo.login || user;
const gists = data?.gists ?? [];

const parseDescription = createGistDescriptionParser({
  prefix: config.gists.prefix,
  split: config.gists.split,
});

const activeTag = Astro.url.searchParams.get('tag')?.trim() ?? '';
const parsedGists = gists.map((gist) => ({
  gist,
  parsed: parseDescription(gist.description),
}));
const tagCounts = collectTagCounts(parsedGists.map((item) => item.parsed));
const filtered = activeTag
  ? parsedGists.filter((item) => hasTag(item.parsed, activeTag))
  : parsedGists;
---

<Layout
  {user}
  userinfo={data?.userinfo ?? null}
  {config}
  theme={themeName}
  brand={display}
  seo={{
    title: `${t('gists.title', { name: display })} · ClassyGit`,
    description: data ? t('gists.desc', { name: display, count: gists.length }) : undefined,
    canonical: `${origin}/${user}/gists`,
    rss: `${origin}/${user}/rss.xml`,
    robots: 'noindex, follow',
  }}
>
  {
    error ? (
      <ServiceError kind={error} />
    ) : !data ? (
      <NotFound user={user} />
    ) : (
      <>
        <div class="list-head">
          <h1 class="page-title">
            {t('gists.title', { name: display })}
            <span class="page-title__count">{filtered.length}</span>
          </h1>
          <div class="list-actions">
            <a class="archive-link" href={`/${user}/archive`} title={t('gists.archive')}>
              {t('gists.archive')}
            </a>
            <a class="rss-link" href={`/${user}/rss.xml`} title={t('gists.rss')}>
              RSS
            </a>
            <ListSearch target="#gist-list" />
          </div>
        </div>

        {tagCounts.length > 0 && (
          <nav class="tag-bar" aria-label={t('gists.tags')}>
            <a class:list={{ 'is-current': !activeTag }} href={`/${user}/gists`}>
              {t('gists.allTags')}
            </a>
            {tagCounts.slice(0, 20).map((tag) => (
              <a
                class:list={{ 'is-current': tag.name.toLowerCase() === activeTag.toLowerCase() }}
                href={`/${user}/gists?tag=${encodeURIComponent(tag.name)}`}
              >
                #{tag.name}<span>{tag.count}</span>
              </a>
            ))}
          </nav>
        )}

        {gists.length === 0 ? (
          <p class="bio">
            {t('gists.empty')}{' '}
            <a
              class="empty-link"
              href="https://gist.github.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('gists.createFirst')} ↗
            </a>
          </p>
        ) : filtered.length === 0 ? (
          <>
            <p class="bio">{t('gists.noTag', { tag: activeTag })}</p>
            <a class="pill-link" href={`/${user}/gists`}>{t('gists.clearTag')}</a>
          </>
        ) : (
          <>
            <ul class="gist-list" id="gist-list">
            {filtered.map(({ gist, parsed }) => (
              <GistCard
                gist={gist}
                href={`/${user}/gist/${gist.id}`}
                type={parsed.type}
                title={parsed.title || Object.keys(gist.files)[0] || t('gist.untitled')}
              />
            ))}
            </ul>
          </>
        )}
      </>
    )
  }
</Layout>
