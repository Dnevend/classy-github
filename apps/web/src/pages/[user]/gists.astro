---
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { listGists } from '../../lib/github';
import { safeLoad } from '../../lib/errors';
import { loadUser } from '../../lib/page';
import { DEFAULT_CONFIG } from '../../lib/config';
import { loadConfig } from '../../lib/config-loader';
import { createGistDescriptionParser } from '../../lib/gist-rule';
import { resolveTheme } from '../../themes';

export const prerender = false;

const user = Astro.params.user as string;
const origin = new URL(Astro.url).origin;

const { data, error } = await safeLoad(async () => {
  const userinfo = await loadUser(user);
  if (!userinfo) return null;

  return { userinfo, gists: await listGists(user) };
});

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!data) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

const config = data ? await loadConfig(user) : DEFAULT_CONFIG;

const { name: themeName, components } = await resolveTheme(
  Astro.url.searchParams.get('theme')
);
const { Layout, GistCard } = components;

const display = data?.userinfo.name || data?.userinfo.login || user;
const gists = data?.gists ?? [];

const parseDescription = createGistDescriptionParser({
  prefix: config.gists.prefix,
  split: config.gists.split,
});
---

<Layout
  {user}
  userinfo={data?.userinfo ?? null}
  {config}
  theme={themeName}
  brand={display}
  seo={{
    title: `${display} 的 Gist · ClassyGit`,
    description: data ? `${display} 在 GitHub Gist 上公开的 ${gists.length} 条记录。` : undefined,
    canonical: `${origin}/${user}/gists`,
    robots: 'noindex, follow',
  }}
>
  {
    error ? (
      <ServiceError kind={error} />
    ) : !data ? (
      <NotFound user={user} />
    ) : (
      <>
        <h1 class="page-title">
          {display} 的 Gist
          <span class="page-title__count">{gists.length}</span>
        </h1>

        {gists.length === 0 ? (
          <p class="bio">没有公开 Gist。</p>
        ) : (
          <ul class="gist-list">
            {gists.map((gist) => {
              const parsed = parseDescription(gist.description);
              return (
                <GistCard
                  gist={gist}
                  href={`/${user}/gist/${gist.id}`}
                  type={parsed.type}
                  title={parsed.title || Object.keys(gist.files)[0] || '未命名 Gist'}
                />
              );
            })}
          </ul>
        )}
      </>
    )
  }
</Layout>
