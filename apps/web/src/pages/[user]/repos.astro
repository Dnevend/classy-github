---
import NotFound from '../../components/NotFound.astro';
import ServiceError from '../../components/ServiceError.astro';
import { listRepos } from '../../lib/github';
import { safeLoad } from '../../lib/errors';
import { loadUser } from '../../lib/page';
import { DEFAULT_CONFIG, type ResolvedConfig } from '../../lib/config';
import { loadConfig } from '../../lib/config-loader';
import { localeFromConfig, createTranslator } from '../../lib/i18n';
import { resolveTheme } from '../../themes';
import ListSearch from '../../themes/_shared/ListSearch.astro';

export const prerender = false;

const PER_PAGE = 30;

const user = Astro.params.user as string;
const origin = new URL(Astro.url).origin;

const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;

const { data, error } = await safeLoad(async () => {
  const userinfo = await loadUser(user);
  if (!userinfo) return null;

  return { userinfo, repos: await listRepos(user, { page, perPage: PER_PAGE }) };
});

if (error) {
  Astro.response.status = error === 'rate-limit' ? 503 : 500;
  Astro.response.headers.set('cache-control', 'no-store');
} else if (!data) {
  Astro.response.status = 404;
  Astro.response.headers.set('cache-control', 'no-store');
}

const config: ResolvedConfig = data ? await loadConfig(user) : DEFAULT_CONFIG;

// 语言优先级：?lang= > cookie > 用户配置 > en
if (Astro.locals.localeChoice === 'auto') {
  Astro.locals.locale = localeFromConfig(config.language);
}

const t = createTranslator(Astro.locals.locale);

const { name: themeName, components } = await resolveTheme(Astro.locals.theme);
const { Layout, RepoCard } = components;

const display = data?.userinfo.name || data?.userinfo.login || user;
const hasNext = (data?.repos.length ?? 0) === PER_PAGE;
const hasPrev = page > 1;
---

<Layout
  {user}
  userinfo={data?.userinfo ?? null}
  {config}
  theme={themeName}
  brand={display}
  seo={{
    title: data ? t('repos.title', { name: display }) : `${display} · ClassyGit`,
    description: data
      ? t('repos.desc', { name: display, count: data.userinfo.public_repos })
      : undefined,
    canonical: `${origin}/${user}/repos${page > 1 ? `?page=${page}` : ''}`,
    robots: 'noindex, follow',
  }}
>
  {
    error ? (
      <ServiceError kind={error} />
    ) : !data ? (
      <NotFound user={user} />
    ) : (
      <>
        <div class="list-head">
          <h1 class="page-title">
            {t('repos.title', { name: display })}
            <span class="page-title__count">{data.userinfo.public_repos}</span>
          </h1>
          <ListSearch target="#repo-list" />
        </div>

        {data.repos.length === 0 ? (
          <p class="bio">{t('repos.empty')}</p>
        ) : (
          <>
            <ul class="repo-grid" id="repo-list">
              {data.repos.map((repo) => (
                <RepoCard repo={repo} href={`/${user}/repo/${repo.name}`} />
              ))}
            </ul>
          </>
        )}

        {(hasPrev || hasNext) && (
          <nav class="pager" aria-label="pagination">
            {hasPrev ? (
              <a class="pager__link" href={`/${user}/repos${page === 2 ? '' : `?page=${page - 1}`}`}>
                ← {t('repos.prev')}
              </a>
            ) : (
              <span />
            )}
            <span class="pager__page">{t('repos.page', { page, total: page + (hasNext ? 1 : 0) })}</span>
            {hasNext ? (
              <a class="pager__link" href={`/${user}/repos?page=${page + 1}`}>
                {t('repos.next')} →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </>
    )
  }
</Layout>
