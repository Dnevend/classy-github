---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import ProfileMeta from '../_shared/ProfileMeta.astro';

const { userinfo } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);

const stats = [
  { label: t('profile.followers'), value: userinfo.followers },
  { label: t('profile.following'), value: userinfo.following },
  { label: t('profile.reposTitle'), value: userinfo.public_repos },
  { label: t('profile.gistsTitle'), value: userinfo.public_gists },
];
---

<aside class="mac-aside">
  <div class="mac-window">
    <div class="mac-titlebar">
      <span class="mac-close" aria-hidden="true"></span>
      <span class="mac-title">About This User</span>
    </div>

    <div class="mac-body">
      <div class="mac-profile">
        <img
          class="mac-avatar"
          src={userinfo.avatar_url}
          alt={`${userinfo.login} 的头像`}
          width="64"
          height="64"
          loading="lazy"
        />
        <div>
          <p class="mac-name">{userinfo.name || userinfo.login}</p>
          <p class="mac-handle">@{userinfo.login}</p>
        </div>
      </div>

      {userinfo.bio && <p class="mac-bio">{userinfo.bio}</p>}
      <ProfileMeta userinfo={userinfo} />

      <div class="mac-stats">
        {stats.map((stat) => (
          <div class="mac-stat">
            <span class="mac-stat__value">{stat.value}</span>
            <span class="mac-stat__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</aside>
