---
import type { ThemeRepoCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import { langColor } from '../../lib/lang-color';

const { repo, href } = Astro.props as ThemeRepoCardProps;
const t = createTranslator(Astro.locals.locale);
---

<li class="mac-repo">
  <div class="mac-window">
    <div class="mac-titlebar">
      <span class="mac-title mac-repo__name">{repo.name}</span>
    </div>

    <div class="mac-body">
      {repo.description && <p class="mac-repo__desc">{repo.description}</p>}

      <p class="mac-repo__meta">
        ★ {repo.stargazers_count} · ⑂ {repo.forks_count}
        {repo.language && <> · <i class="lang-dot" style={`background:${langColor(repo.language)}`}></i>{repo.language}</>}
        {repo.updated_at && <> · {repo.updated_at.slice(0, 10)}</>}
      </p>

      <a class="mac-btn" {href}>{t('card.open')}</a>
    </div>
  </div>
</li>
