---
import { createTranslator } from '../../lib/i18n';
import { siteOrigin } from '../../lib/site';
import { sameOriginPath } from '../../lib/site-url';

export interface ShareCardData {
  /** 卡片主标题：用户名 / 仓库名 / Gist 标题 */
  title: string;
  /** 副标题：简介、描述或截断后的正文 */
  description?: string | null;
  /** @handle，用于二维码下载文件名 */
  handle: string;
  avatar?: string | null;
  url: string;
}

interface Props extends ShareCardData {
  /** 用户资料卡封面；有值时分享卡使用背景图版本 */
  cover?: string | null;
}

const { title, description, handle, avatar, url, cover } = Astro.props as Props;
const t = createTranslator(Astro.locals.locale);

// 封面可能是本站另一个入口的绝对地址（例如 classygit.pages.dev），
// 分享卡的 <img crossorigin> 会按跨域处理并加载失败；统一转成站内路径。
const coverSrc = sameOriginPath(cover, siteOrigin(Astro.url));

const host = url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const tweetHref = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(
  t('share.tweet', { name: title })
)}`;
---

<div
  class="share-card"
  data-share
  data-title={title}
  data-handle={handle}
  data-description={description ?? ''}
>
  <button
    class="share-card__trigger"
    type="button"
    aria-expanded="false"
    aria-label={t('share.trigger')}
    title={t('share.trigger')}
    data-share-toggle
  >
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M7 18h10a4 4 0 0 0 .6-7.96A6 6 0 0 0 6 9.2 4.4 4.4 0 0 0 7 18Z"
      ></path>
    </svg>
    <span class="share-card__trigger-text">{t('share.trigger')}</span>
  </button>

  <div class="share-card__panel" role="dialog" aria-label={t('share.trigger')} data-share-panel>
    <div
      class:list={['share-card__preview', { 'has-cover': !!coverSrc }]}
      data-share-preview
    >
      {
        coverSrc && (
          <>
            <img
              class="share-card__cover"
              src={coverSrc}
              alt=""
              crossorigin="anonymous"
              loading="lazy"
              decoding="async"
              data-share-cover
            />
            <span class="share-card__cover-shade" aria-hidden="true" />
          </>
        )
      }
      <span class="share-card__watermark" aria-hidden="true">ClassyGit</span>

      {
        avatar && (
          <img
            class="share-card__avatar"
            src={avatar}
            alt=""
            width="120"
            height="120"
            crossorigin="anonymous"
            loading="lazy"
            decoding="async"
            data-avatar="1"
            data-share-avatar
          />
        )
      }

      <div class="share-card__text">
        <strong class="share-card__name">{title}</strong>
        <span class="share-card__handle">@{handle}</span>
      </div>

      {description && <p class="share-card__desc">{description}</p>}

      <div class="share-card__meta">
        <span class="share-card__site">ClassyGit</span>
        <span class="share-card__url">{host}</span>
      </div>

      <img class="share-card__qr" alt="" width="84" height="84" data-share-qr />
    </div>

    <div class="share-card__actions">
      <a
        class="share-card__action"
        href={tweetHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('share.twitter')}
        title={t('share.twitter')}
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M18.9 2H22l-7.2 8.2L23 22h-6.6l-5.2-6.8L5.3 22H2.2l7.7-8.8L1.6 2h6.8l4.7 6.2L18.9 2Zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20Z"
          ></path>
        </svg>
      </a>

      <button
        class="share-card__action"
        type="button"
        aria-label={t('share.save')}
        title={t('share.save')}
        data-share-save
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v3h16v-3"
          ></path>
        </svg>
      </button>

      <button
        class="share-card__action"
        type="button"
        aria-label={t('share.copy')}
        title={t('share.copy')}
        data-share-copy
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 1 0-5.7-5.7L11.5 7M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7L12.5 17"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector('[data-share]') as HTMLElement | null;
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-share-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-share-panel]');
    const saveBtn = root.querySelector<HTMLButtonElement>('[data-share-save]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-share-copy]');
    const qrImg = root.querySelector<HTMLImageElement>('[data-share-qr]');
    const preview = root.querySelector<HTMLElement>('[data-share-preview]');

    // 面板默认 display:none，封面/头像用 lazy 延迟到打开时再加载；
    // 截图前等它们真正 decode 完，避免保存出一张缺图的卡片。
    const waitForImages = (scope: HTMLElement) =>
      Promise.all(
        [...scope.querySelectorAll('img')].map((img) => {
          if (img.complete) return Promise.resolve();
          return new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true });
            img.addEventListener('error', () => resolve(), { once: true });
          });
        })
      );

    // 二维码库只在真正打开分享面板时加载，避免每个页面都下载 qrcode-generator。
    let qrReady: Promise<void> | undefined;
    const ensureQr = (): Promise<void> => {
      if (!qrImg) return Promise.resolve();
      if (qrReady) return qrReady;

      qrReady = import('qrcode-generator')
        .then(({ default: qrcode }) => {
          const qr = qrcode(0, 'M');
          qr.addData(location.href);
          qr.make();
          qrImg.src = qr.createDataURL(4, 0);
        })
        .catch((error) => {
          console.warn('[classy] 二维码生成失败', error);
          qrReady = undefined;
        });

      return qrReady;
    };

    const open = (state: boolean) => {
      if (!panel || !toggle) return;
      toggle.setAttribute('aria-expanded', String(state));
      if (state) {
        root.setAttribute('data-open', '');
        void ensureQr();
      } else {
        root.removeAttribute('data-open');
      }
    };

    root.addEventListener('pointerenter', () => void ensureQr(), { once: true });
    toggle?.addEventListener('click', () => open(!root.hasAttribute('data-open')));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && open(false));
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) open(false);
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        const shareUrl = new URL(location.href);
        const currentTheme = document.documentElement.dataset.theme;
        if (currentTheme) shareUrl.searchParams.set('theme', currentTheme);
        await navigator.clipboard.writeText(shareUrl.toString());
        copyBtn.classList.add('is-done');
        setTimeout(() => copyBtn.classList.remove('is-done'), 1200);
      } catch {
        /* 剪贴板不可用时静默失败 */
      }
    });

    saveBtn?.addEventListener('click', async () => {
      if (!preview) return;

      try {
        // 直接截取用户看到的那张卡，缩放到 1200 宽，所见即所得
        const { domToCanvas } = await import('modern-screenshot');
        await ensureQr();
        await Promise.all([waitForImages(preview), document.fonts.ready.catch(() => {})]);
        const canvas = await domToCanvas(preview, {
          scale: 1200 / preview.offsetWidth,
          backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() || '#ffffff',
        });

        canvas.toBlob((blob) => {
          if (!blob) return;
          const link = document.createElement('a');
          link.download = `classy-${root.dataset.handle ?? 'card'}.png`;
          link.href = URL.createObjectURL(blob);
          link.click();
          setTimeout(() => URL.revokeObjectURL(link.href), 2000);
        }, 'image/png');
      } catch (error) {
        console.warn('[classy] 分享图生成失败', error);
      }
    });
  }
</script>
