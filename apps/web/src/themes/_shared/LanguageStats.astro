---
interface Props {
  languages?: { name: string; count: number; color: string }[];
}

const { languages = [] } = Astro.props as Props;
const total = languages.reduce((sum, item) => sum + item.count, 0);
---

{
  languages.length > 0 && total > 0 && (
    <div class="lang-stats">
      <div class="lang-stats__bar" role="img" aria-label={languages.map((l) => `${l.name} ${Math.round((l.count / total) * 100)}%`).join(', ')}>
        {languages.map((item) => (
          <span
            style={`width:${((item.count / total) * 100).toFixed(1)}%;background:${item.color}`}
            title={item.name}
          />
        ))}
      </div>
      <ul class="lang-stats__legend">
        {languages.map((item) => (
          <li>
            <i style={`background:${item.color}`} />
            {item.name}
            <b>{Math.round((item.count / total) * 100)}%</b>
          </li>
        ))}
      </ul>
    </div>
  )
}
