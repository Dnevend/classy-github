---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import ProfileMeta from '../_shared/ProfileMeta.astro';
import NowCard from '../_shared/NowCard.astro';

const { userinfo, links, config } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);
---

<aside class="nes-aside">
  <section class="nes-container with-title is-rounded is-dark">
    <p class="title">PLAYER</p>

    <div class="nes-profile">
      <img
        class="nes-avatar"
        src={userinfo.avatar_url}
        alt={`${userinfo.login} 的头像`}
        width="64"
        height="64"
        loading="lazy"
      />
      <div>
        <p class="nes-name">{userinfo.name || userinfo.login}</p>
        <p class="nes-handle">@{userinfo.login}</p>
      </div>
    </div>

    {userinfo.bio && <p class="nes-bio">{userinfo.bio}</p>}
    <ProfileMeta userinfo={userinfo} />
    <NowCard now={config.now} cardUrl={config.profile.cardUrl} />

    <ul class="nes-stats">
      {config.profile.showFollowers && (
        <li><span>{userinfo.followers}</span> {t('profile.followers')}</li>
      )}
      {config.profile.showFollowing && (
        <li><span>{userinfo.following}</span> {t('profile.following')}</li>
      )}
      <li><span>{userinfo.public_repos}</span> {t('profile.reposTitle')}</li>
      <li><span>{userinfo.public_gists}</span> {t('profile.gistsTitle')}</li>
    </ul>

    <div class="nes-actions">
      <a class="nes-btn is-success" href={links.repos}>{t('profile.reposTitle')}</a>
      <a class="nes-btn is-warning" href={links.gists}>{t('profile.gistsTitle')}</a>
      {links.guestbook && (
        <a class="nes-btn is-primary" href={links.guestbook}>{t('nav.guestbook')}</a>
      )}
      <a class="nes-btn" href={userinfo.html_url} target="_blank" rel="noopener noreferrer">
        {t('profile.github')}
      </a>
    </div>
  </section>
</aside>
