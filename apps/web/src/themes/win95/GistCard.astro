---
import type { ThemeGistCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';

const { gist, href, type, title, compact = false } = Astro.props as ThemeGistCardProps;
const t = createTranslator(Astro.locals.locale);
---

<li class="w95-gist">
  <a href={href}>
    <span class="w95-gist__icon" aria-hidden="true">📄</span>
    <span class="w95-gist__title">{title}</span>
    <span class="w95-gist__meta">
      {!compact && type && <span class="w95-tag">{type}</span>}
      {!compact && `${t('gists.files', { count: Object.keys(gist.files).length })} · `}
      {gist.created_at.slice(0, 10)}
    </span>
  </a>
</li>
