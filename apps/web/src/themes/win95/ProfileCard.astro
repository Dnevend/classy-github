---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import ProfileMeta from '../_shared/ProfileMeta.astro';

const { userinfo, config } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);
---

<aside class="w95-aside">
  <div class="window">
    <div class="title-bar">
      <div class="title-bar-text">{userinfo.login}.exe</div>
      <div class="title-bar-controls">
        <button aria-label="Help"></button>
      </div>
    </div>

    {config.profile.cover && (
      <div class="profile-cover">
        <img src={config.profile.cover} alt="" loading="lazy" />
      </div>
    )}

    <div class="window-body">
      <div class:list={['w95-profile', { 'has-cover': !!config.profile.cover }]}>
        <img
          class="w95-avatar"
          src={userinfo.avatar_url}
          alt={`${userinfo.login} 的头像`}
          width="64"
          height="64"
          loading="lazy"
        />
        <div>
          <p class="w95-name">{userinfo.name || userinfo.login}</p>
          <p class="w95-handle">@{userinfo.login}</p>
        </div>
      </div>

      {userinfo.bio && <p class="w95-bio">{userinfo.bio}</p>}
      <ProfileMeta userinfo={userinfo} />

      <fieldset class="w95-stats">
        <legend>stats</legend>
        <ul>
          <li><b>{userinfo.followers}</b> <span>{t('profile.followers')}</span></li>
          <li><b>{userinfo.following}</b> <span>{t('profile.following')}</span></li>
          <li><b>{userinfo.public_repos}</b> <span>{t('profile.reposTitle')}</span></li>
          <li><b>{userinfo.public_gists}</b> <span>{t('profile.gistsTitle')}</span></li>
        </ul>
      </fieldset>
    </div>
  </div>
</aside>
