---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import ProfileMeta from '../_shared/ProfileMeta.astro';

const { userinfo } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);
---

<aside class="w95-aside">
  <div class="window">
    <div class="title-bar">
      <div class="title-bar-text">{userinfo.login}.exe</div>
      <div class="title-bar-controls">
        <button aria-label="Minimize"></button>
        <button aria-label="Maximize"></button>
        <button aria-label="Close"></button>
      </div>
    </div>

    <div class="window-body">
      <div class="w95-profile">
        <img
          class="w95-avatar"
          src={userinfo.avatar_url}
          alt={`${userinfo.login} 的头像`}
          width="64"
          height="64"
          loading="lazy"
        />
        <div>
          <p class="w95-name">{userinfo.name || userinfo.login}</p>
          <p class="w95-handle">@{userinfo.login}</p>
        </div>
      </div>

      {userinfo.bio && <p class="w95-bio">{userinfo.bio}</p>}
      <ProfileMeta userinfo={userinfo} />

      <fieldset class="w95-stats">
        <legend>stats</legend>
        <ul>
          <li>{userinfo.followers} {t('profile.followers')}</li>
          <li>{userinfo.following} {t('profile.following')}</li>
          <li>{userinfo.public_repos} {t('profile.reposTitle')}</li>
          <li>{userinfo.public_gists} {t('profile.gistsTitle')}</li>
        </ul>
      </fieldset>
    </div>
  </div>
</aside>
