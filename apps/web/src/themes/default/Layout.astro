---
import Base from '../../layouts/Base.astro';
import ThemeSwitcher from '../_shared/ThemeSwitcher.astro';
import ShareCard from '../_shared/ShareCard.astro';
import type { ThemeLayoutProps } from '../types';

// 动态 import 的模块里直接 import CSS 不会被 Astro 收集，用 ?url 显式注入
import themeCss from './theme.css?url';

const { user, userinfo, config, theme, seo, brand } = Astro.props as ThemeLayoutProps;

const shareUrl = seo.canonical ?? Astro.url.href;
---

<Base {seo} {theme}>
  <Fragment slot="head">
    <link rel="stylesheet" href={themeCss} />
  </Fragment>

  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true">◍</span>
        ClassyGit
      </a>

      {
        userinfo && (
          <nav class="site-nav">
            <a href={`/${user}`} class="is-active">
              主页
            </a>
            <a href={`/${user}/repos`}>Repos</a>
            <a href={`/${user}/gists`}>Gists</a>
          </nav>
        )
      }

      {brand && <span class="site-header__brand">{brand}</span>}
    </div>
  </header>

  <main class="container page">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container site-footer__inner">
      {
        config.links.length > 0 && (
          <nav class="site-footer__links">
            {config.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.title}
              </a>
            ))}
          </nav>
        )
      }
      <span>
        Powered by <a href="https://github.com/Dnevend/classy-github">ClassyGit</a>
      </span>
      {userinfo && (
          <ShareCard
            user={userinfo.login}
            brand={brand ?? userinfo.login}
            avatar={userinfo.avatar_url}
            url={shareUrl}
            theme={theme}
          />
        )}
        <ThemeSwitcher current={theme} />
    </div>
  </footer>
</Base>
