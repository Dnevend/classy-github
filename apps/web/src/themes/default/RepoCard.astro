---
import type { ThemeRepoCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import { langColor } from '../../lib/lang-color';

const { repo, href } = Astro.props as ThemeRepoCardProps;
const t = createTranslator(Astro.locals.locale);
---

<li>
  <a class="repo-card" {href}>
    <span class="repo-card__name">{repo.name}</span>
    {repo.description && <p class="repo-card__desc">{repo.description}</p>}
    <span class="repo-card__meta">
      <span>★ {repo.stargazers_count}</span>
      <span>⑂ {repo.forks_count}</span>
      {repo.language && <span class="dot"><i class="lang-dot" style={`background:${langColor(repo.language)}`}></i>{repo.language}</span>}
      <span>updated {repo.updated_at?.slice(0, 10)}</span>
    </span>
  </a>
</li>
