---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import ProfileMeta from '../_shared/ProfileMeta.astro';
import StatsCard from '../_shared/StatsCard.astro';

const { userinfo, links, stats } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);
---

<aside class="profile__aside">
  <div class="card profile-card">
    <div class="profile-card__head">
      <img
        class="avatar"
        src={userinfo.avatar_url}
        alt={`${userinfo.login} 的头像`}
        width="48"
        height="48"
        loading="lazy"
      />
      <div>
        <h1>{userinfo.name || userinfo.login}</h1>
        <div class="login">@{userinfo.login}</div>
      </div>
    </div>

    {userinfo.bio && <p class="bio">{userinfo.bio}</p>}
    <ProfileMeta userinfo={userinfo} />
    <StatsCard repos={userinfo.public_repos} stars={stats?.stars ?? 0} gists={userinfo.public_gists} followers={userinfo.followers} languages={stats?.languages ?? 0} />

    <div class="stats">
      <span><b>{userinfo.followers}</b> {t('profile.followers')}</span>
      <span><b>{userinfo.following}</b> {t('profile.following')}</span>
    </div>

    <div class="stats">
      <a href={links.repos}><b>{userinfo.public_repos}</b> {t('profile.reposTitle')}</a>
      <a href={links.gists}><b>{userinfo.public_gists}</b> {t('profile.gistsTitle')}</a>
    </div>

    <div class="stats">
      <a href={userinfo.html_url} target="_blank" rel="noopener noreferrer">{t('profile.github')} ↗</a>
      {
        userinfo.blog && (
          <a href={userinfo.blog} target="_blank" rel="noopener noreferrer">
            {t('profile.website')} ↗
          </a>
        )
      }
    </div>
  </div>
</aside>
