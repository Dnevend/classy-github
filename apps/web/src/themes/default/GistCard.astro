---
import type { ThemeGistCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';

const { gist, href, type, title } = Astro.props as ThemeGistCardProps;
const t = createTranslator(Astro.locals.locale);
---

<li>
  <a class="gist-item" {href}>
    <span class="gist-item__title">{title}</span>
    <span class="gist-item__meta">
      {type && <span class="tag">{type}</span>}
      {t('gists.files', { count: Object.keys(gist.files).length })} · {gist.created_at.slice(0, 10)}
    </span>
  </a>
</li>
