---
import type { ThemeMarkdownProps } from '../types';

const { html, title = 'README.TXT' } = Astro.props as ThemeMarkdownProps;
---

<div class="tui-panel tui-box tui-readme">
  <div class="tui-box__head tui-box__head--controls">
    <span>{title}</span>
    <span class="tui-controls" aria-hidden="true">[-] [□] [X]</span>
  </div>
  <div class="tui-box__body">
    <div class="prose" set:html={html} />
  </div>
</div>
