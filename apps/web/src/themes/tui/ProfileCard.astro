---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';
import { avatarUrl } from '../../lib/avatar';
import ProfileMeta from '../_shared/ProfileMeta.astro';
import ProfileCover from '../_shared/ProfileCover.astro';

const { userinfo, config } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);

const stats = [
  { label: t('profile.followers'), value: userinfo.followers },
  { label: t('profile.following'), value: userinfo.following },
  { label: t('profile.reposTitle'), value: userinfo.public_repos },
  { label: t('profile.gistsTitle'), value: userinfo.public_gists },
];
---

<aside class="tui-aside">
  <div class="tui-panel tui-box">
    <div class="tui-box__head tui-box__head--controls">
      <span>USER INFO</span>
      <span class="tui-controls" aria-hidden="true">[?]</span>
    </div>

    <ProfileCover cover={config.profile.cover} />

    <div class="tui-box__body">
      <div class:list={['tui-profile', 'has-cover']}>
        <img
          class="tui-avatar"
          src={avatarUrl(userinfo)}
          alt={`${userinfo.login} 的头像`}
          width="64"
          height="64"
          loading="lazy"
          decoding="async"
          data-avatar="1"
        />
        <div>
          <p class="tui-name">{userinfo.name || userinfo.login}</p>
          <p class="tui-handle">@{userinfo.login}</p>
        </div>
      </div>

      {userinfo.bio && <p class="tui-bio">{userinfo.bio}</p>}
      <ProfileMeta userinfo={userinfo} />

      <ul class="tui-stats">
        {stats.map((stat) => (
          <li><span>{stat.label}</span><b>{stat.value}</b></li>
        ))}
      </ul>
    </div>
  </div>
</aside>
