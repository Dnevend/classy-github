---
import type { ThemeProfileCardProps } from '../types';
import { createTranslator } from '../../lib/i18n';

const { userinfo, links } = Astro.props as ThemeProfileCardProps;
const t = createTranslator(Astro.locals.locale);
---

<aside class="tui-aside">
  <div class="tui-panel tui-box">
    <div class="tui-box__head">USER INFO</div>

    <div class="tui-box__body">
      <div class="tui-profile">
        <img
          class="tui-avatar"
          src={userinfo.avatar_url}
          alt={`${userinfo.login} 的头像`}
          width="64"
          height="64"
          loading="lazy"
        />
        <div>
          <p class="tui-name">{userinfo.name || userinfo.login}</p>
          <p class="tui-handle">@{userinfo.login}</p>
        </div>
      </div>

      {userinfo.bio && <p class="tui-bio">{userinfo.bio}</p>}

      <ul class="tui-stats">
        <li><span>{t('profile.followers')}</span><b>{userinfo.followers}</b></li>
        <li><span>{t('profile.following')}</span><b>{userinfo.following}</b></li>
        <li><span>{t('profile.repos')}</span><b>{userinfo.public_repos}</b></li>
        <li><span>{t('profile.gists')}</span><b>{userinfo.public_gists}</b></li>
      </ul>

      <div class="tui-actions">
        <a class="tui-button" href={links.repos}>{t('profile.repos')}</a>
        <a class="tui-button" href={links.gists}>{t('profile.gists')}</a>
        <a class="tui-button" href={userinfo.html_url} target="_blank" rel="noopener noreferrer">
          {t('profile.github')}
        </a>
      </div>
    </div>
  </div>
</aside>
