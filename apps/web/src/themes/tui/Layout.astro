---
import Base from '../../layouts/Base.astro';
import ThemeSwitcher from '../_shared/ThemeSwitcher.astro';
import LanguageSwitcher from '../_shared/LanguageSwitcher.astro';
import { createTranslator } from '../../lib/i18n';
import ShareCard from '../_shared/ShareCard.astro';
import CommunityFooter from '../_shared/CommunityFooter.astro';
import type { ThemeLayoutProps } from '../types';
import { avatarUrl, avatarUrlForLogin } from '../../lib/avatar';

import vendorCss from './vendor/tuicss.min.css?url';
import themeCss from './theme.css?url';

const { user, userinfo, config, theme, seo, brand, share, configured = false } =
  Astro.props as ThemeLayoutProps;

const shareUrl = seo.canonical ?? Astro.url.href;
const shareData =
  share ??
  (userinfo
    ? {
        title: brand || userinfo.login,
        description: userinfo.bio,
        handle: userinfo.login,
        avatar: userinfo.avatar_url,
        url: shareUrl,
      }
    : null);
const t = createTranslator(Astro.locals.locale);
---

<Base {seo} {theme} user={user} userName={brand || userinfo?.name || user}>
  <Fragment slot="head">
    <link rel="stylesheet" href={vendorCss} />
    <link rel="stylesheet" href={themeCss} />
  </Fragment>

  <div class="tui-screen">
    <header class="tui-bar">
      <a class="tui-logo" href="/">CLASSYGIT</a>

      {
        user && (
          <nav class="tui-nav">
            <a href={`/${user}/repos`}>{t('nav.repos')}</a>
            <a href={`/${user}/gists`}>{t('nav.gists')}</a>
            {config.guestbook.gistId && (
              <a href={`/${user}/guestbook`}>{t('nav.guestbook')}</a>
            )}
          </nav>
        )
      }

      {brand && <a class="tui-brand" href={user ? `/${user}` : "/"}>{brand}</a>}
      {user && (
        <img
          class="header-avatar"
          src={userinfo ? avatarUrl(userinfo) : avatarUrlForLogin(user, 64)}
          alt=""
          width="26"
          height="26"
          decoding="async"
          data-avatar="1"
        />
      )}
    </header>

    <main class="tui-main">
      <slot />
    </main>

    <footer class="tui-footer">
      {
        config.links.length > 0 && (
          <nav class="tui-links">
            {config.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.title} ↗
              </a>
            ))}
          </nav>
        )
      }
      <CommunityFooter user={user} {configured} webring={config.webring.enabled} />
      <div class="tui-footer__row">
        <span>F1=HELP  F10=MENU  © CLASSYGIT</span>
        {shareData && <ShareCard {...shareData} theme={theme} cover={config.profile.cover} />}
        <div class="switchers">
          <LanguageSwitcher current={Astro.locals.locale} />
          <ThemeSwitcher current={theme} />
        </div>
      </div>
    </footer>
  </div>
</Base>
