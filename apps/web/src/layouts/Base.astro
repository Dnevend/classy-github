---
import Seo from '../components/Seo.astro';
import type { SeoMeta } from '../lib/seo';
import '../styles/global.css';

interface Props {
  seo: SeoMeta;
  /** 当前主题名，写到 <html data-theme> 上，主题 CSS 可据此限定作用域 */
  theme?: string;
}

const { seo, theme = 'default' } = Astro.props as Props;
---

<!doctype html>
<html lang={Astro.locals.locale === 'zh' ? 'zh-CN' : 'en'} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/github.svg" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" />
    <Seo {...seo} />
    <slot name="head" />
  </head>

  <body>
    <slot />

    <script is:inline>
      // README 里的第三方图片（统计卡、徽章）经常 404 或超时，
      // 失败时把 <img> 收起来，别留一块空白。
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) target.style.display = 'none';
        },
        true
      );
    </script>
  </body>
</html>
