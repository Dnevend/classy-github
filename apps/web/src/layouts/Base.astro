---
import Seo from '../components/Seo.astro';
import type { SeoMeta } from '../lib/seo';
import { PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/client';
import '../styles/global.css';

interface Props {
  seo: SeoMeta;
  /** 当前主题名，写到 <html data-theme> 上，主题 CSS 可据此限定作用域 */
  theme?: string;
  /** 当前用户页的 login；用于「最近访问」本地记录 */
  user?: string;
  userName?: string;
}

const { seo, theme = 'mac', user = '', userName = '' } = Astro.props as Props;

// Cloudflare Web Analytics：只生产构建且配置了 token 时注入。
// 所有主题 Layout 和 404 都用 Base，所以这一处覆盖全站 HTML；
// RSS / sitemap / badge / OG / JSON 不走 Base，不会带脚本。
const cfBeaconToken = import.meta.env.PROD ? PUBLIC_CF_ANALYTICS_TOKEN : undefined;
---

<!doctype html>
<html lang={Astro.locals.locale === 'zh' ? 'zh-CN' : 'en'} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/github.svg" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" />
    <script is:inline>
      // README 里的第三方图片（统计卡、徽章）经常 404 或超时，
      // 失败时把 <img> 收起来，别留一块空白。
      //
      // 头像是页面结构的一部分，隐藏会让布局塌陷；失败时换成透明 GIF，
      // 保留 CSS 里的剪影占位图（见 global.css 的 avatar 规则）。
      //
      // 必须放在 <head>：头像是页面里最早的图片之一，放在 body 末尾会错过
      // 它的 error 事件（图片已经加载失败，监听器还没注册）。
      const AVATAR_PLACEHOLDER =
        'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (!(target instanceof HTMLImageElement)) return;

          if (target.hasAttribute('data-avatar')) {
            if (target.dataset.avatarFailed) return;
            target.dataset.avatarFailed = '1';
            target.src = AVATAR_PLACEHOLDER;
            return;
          }

          target.style.display = 'none';
        },
        true
      );
    </script>
    <Seo {...seo} />
    {
      cfBeaconToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        ></script>
      )
    }
    <slot name="head" />
  </head>

  <body data-classy-user={user} data-classy-name={userName}>
    <slot />

    <script is:inline>
      // 右侧资料卡的 sticky top 要跟实际 header 高度一致；写死 84px 会让
      // header 较矮的主题（Mac）右栏比左栏低一截。
      (() => {
        const setHeaderOffset = () => {
          const header = document.querySelector('header');
          if (!header) return;
          const offset = Math.round(header.offsetTop + header.offsetHeight);
          document.documentElement.style.setProperty(
            '--classy-header-offset',
            `${offset}px`
          );
        };

        setHeaderOffset();
        window.addEventListener('resize', setHeaderOffset);
      })();
    </script>

    <script is:inline>
      // 记录最近访问的用户页到 localStorage（只在页面访问自己的 /<login> 路径时）。
      (() => {
        const login = document.body.dataset.classyUser;
        if (!login) return;

        const first = location.pathname.split('/').filter(Boolean)[0];
        if (!first || first.toLowerCase() !== login.toLowerCase()) return;

        const reserved = new Set(['setup', 'webring', 'badge', 'claim', 'api', 'og', 'random']);
        if (reserved.has(first.toLowerCase())) return;

        const name = document.body.dataset.classyName || login;
        const key = 'classy:recent';

        try {
          const raw = JSON.parse(localStorage.getItem(key) || '[]');
          const list = Array.isArray(raw) ? raw : [];
          const next = [
            { login, name, at: Date.now() },
            ...list.filter(
              (item) =>
                item &&
                String(item.login).toLowerCase() !== login.toLowerCase()
            ),
          ].slice(0, 8);
          localStorage.setItem(key, JSON.stringify(next));
        } catch {
          // localStorage 不可用时静默跳过
        }
      })();
    </script>
  </body>
</html>
