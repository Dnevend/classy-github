---
import Seo from '../components/Seo.astro';
import type { SeoMeta } from '../lib/seo';
import '../styles/global.css';

interface Props {
  seo: SeoMeta;
  /** 当前主题名，写到 <html data-theme> 上，主题 CSS 可据此限定作用域 */
  theme?: string;
  /** 当前用户页的 login；用于「最近访问」本地记录 */
  user?: string;
  userName?: string;
}

const { seo, theme = 'default', user = '', userName = '' } = Astro.props as Props;
---

<!doctype html>
<html lang={Astro.locals.locale === 'zh' ? 'zh-CN' : 'en'} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/github.svg" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" />
    <Seo {...seo} />
    <slot name="head" />
  </head>

  <body data-classy-user={user} data-classy-name={userName}>
    <slot />

    <script is:inline>
      // README 里的第三方图片（统计卡、徽章）经常 404 或超时，
      // 失败时把 <img> 收起来，别留一块空白。
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) target.style.display = 'none';
        },
        true
      );
    </script>

    <script is:inline>
      // 记录最近访问的用户页到 localStorage（只在页面访问自己的 /<login> 路径时）。
      (() => {
        const login = document.body.dataset.classyUser;
        if (!login) return;

        const first = location.pathname.split('/').filter(Boolean)[0];
        if (!first || first.toLowerCase() !== login.toLowerCase()) return;

        const reserved = new Set(['setup', 'webring', 'badge', 'claim', 'api', 'og', 'random']);
        if (reserved.has(first.toLowerCase())) return;

        const name = document.body.dataset.classyName || login;
        const key = 'classy:recent';

        try {
          const raw = JSON.parse(localStorage.getItem(key) || '[]');
          const list = Array.isArray(raw) ? raw : [];
          const next = [
            { login, name, at: Date.now() },
            ...list.filter(
              (item) =>
                item &&
                String(item.login).toLowerCase() !== login.toLowerCase()
            ),
          ].slice(0, 8);
          localStorage.setItem(key, JSON.stringify(next));
        } catch {
          // localStorage 不可用时静默跳过
        }
      })();
    </script>
  </body>
</html>
