---
import { createTranslator } from '../lib/i18n';

const t = createTranslator(Astro.locals.locale);

interface Props {
  user?: string;
}

const { user } = Astro.props as Props;
---

<div class="empty">
  <h1>{t('notfound.title')}</h1>
  <p>
    {user ? t('notfound.body', { user }) : t('notfound.page')}
  </p>
  <a href="/">{t('notfound.back')}</a>
</div>
