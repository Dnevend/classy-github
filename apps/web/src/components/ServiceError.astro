---
import type { LoadErrorKind } from '../lib/errors';
import { createTranslator } from '../lib/i18n';

interface Props {
  kind: LoadErrorKind;
}

const { kind } = Astro.props as Props;
const t = createTranslator(Astro.locals.locale);

// 'not-found' 通常由 NotFound 组件处理，这里保留文案只为让类型闭环
const copy =
  kind === 'rate-limit'
    ? { title: t('error.rateLimit.title'), body: t('error.rateLimit.body') }
    : kind === 'not-found'
      ? { title: t('notfound.title'), body: t('notfound.page') }
      : { title: t('error.unknown.title'), body: t('error.unknown.body') };
---

<div class="empty">
  <h1>{copy.title}</h1>
  <p>{copy.body}</p>
  <a href={Astro.url.pathname}>{t('error.retry')}</a>
</div>
