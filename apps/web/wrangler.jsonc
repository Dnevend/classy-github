{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classy-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "SITE_ORIGIN": "https://classygit.pages.dev"
  },
  "kv_namespaces": [
    { "binding": "USERS", "id": "bfa9d7d2b1f44881833552cb30b4077e" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HITS", "class_name": "HitCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HitCounter"] }],
  "observability": {
    "enabled": true
  }
}
