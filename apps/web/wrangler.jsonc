// 这是 Astro 构建的源配置，不能直接 `wrangler deploy`：入口里的
// `virtual:astro:app` 只有 Astro/Vite 构建期能解析。部署请用
// `pnpm deploy:web` 或 apps/web 的 `pnpm deploy`（都会走 dist/server/wrangler.json）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classy-web",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "classygit.dev", "custom_domain": true }
  ],
  // Assets 必须指向构建后的 client 目录；不要把 ./dist 当成静态根目录，
  // 否则 dist/server 会被当成公开静态资源。
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "vars": {
    "SITE_ORIGIN": "https://classygit.dev"
  },
  "ratelimits": [
    {
      "name": "PREVIEW_LIMITER",
      "namespace_id": "3101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PREVIEW_GLOBAL_LIMITER",
      "namespace_id": "3102",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RANDOM_LIMITER",
      "namespace_id": "3103",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RANDOM_GLOBAL_LIMITER",
      "namespace_id": "3104",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "3105",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "API_GLOBAL_LIMITER",
      "namespace_id": "3106",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "BADGE_LIMITER",
      "namespace_id": "3107",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "ASSET_LIMITER",
      "namespace_id": "3108",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "ASSET_GLOBAL_LIMITER",
      "namespace_id": "3109",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "kv_namespaces": [
    { "binding": "USERS", "id": "bfa9d7d2b1f44881833552cb30b4077e" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HITS", "class_name": "HitCounter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HitCounter"] }],
  "observability": {
    "enabled": true
  }
}
