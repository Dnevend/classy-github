# pnpm 的严格 node_modules 布局下，@napi-rs/wasm-runtime 的可选依赖
# （@emnapi/*、@tybys/wasm-util）无法从虚拟 store 里解析到，
# 会导致 `astro check` 启动时报 "Cannot find package '@emnapi/core'"。
# 这几个包只在语言服务器里用，公开提升到根 node_modules 即可解决。
public-hoist-pattern[]=*emnapi*
public-hoist-pattern[]=*tybys*

# Astro 会以 optional peer 的形式拉进 @types/react@19，
# 与仓库里的 react 18 类型冲突，导致旧 app 的 tsc 全线报错。
auto-install-peers=false
