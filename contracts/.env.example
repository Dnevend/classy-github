# Deployer key. Never commit the real one.
PRIVATE_KEY=

# Address of the server-side voucher signer (NFT_SIGNER_ADDRESS in the Worker).
SIGNER_ADDRESS=
SIGNER_PRIVATE_KEY=

# Relayer hot wallet (Phase 5, gasless minting).
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=

# Stable secret used to derive claimKey = keccak256(ghId, theme, CLAIM_SALT).
CLAIM_SALT=

# Optional: initial owner. Defaults to the deployer.
OWNER_ADDRESS=

# Filled after `Deploy.s.sol`.
CONTRACT_ADDRESS=

# Test-only smoke mint (`MintTest.s.sol`). Refuses Base mainnet.
MINT_TO=
MINT_THEME=0

# Filled after pinning the four card images.
IMAGE_URI_MAC=
IMAGE_URI_NES=
IMAGE_URI_WIN98=
IMAGE_URI_TUI=

# Optional: collection metadata URI.
CONTRACT_URI=

# Base Sepolia / Base mainnet RPC.
BASE_RPC_URL=

# For `forge script --verify` (Etherscan V2 / Basescan).
ETHERSCAN_API_KEY=
