# Deployer key. Never commit the real one.
PRIVATE_KEY=

# Address of the server-side voucher signer (NFT_SIGNER_ADDRESS in the Worker).
SIGNER_ADDRESS=

# Optional: initial owner. Defaults to the deployer.
OWNER_ADDRESS=

# Optional: collection metadata URI.
CONTRACT_URI=

# Base Sepolia / Base mainnet RPC.
BASE_RPC_URL=

# For `forge script --verify` (Etherscan V2 / Basescan).
ETHERSCAN_API_KEY=
